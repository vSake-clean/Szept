# Skopiuj do secrets.properties (nie trafia do repozytorium) i uzupełnij.
# Każdą wartość można też podać jako zmienną środowiskową o tej samej nazwie (np. w CI).

# Podpis wydania — ten sam klucz dla każdej wersji, inaczej Android nie zainstaluje aktualizacji
SZEPT_KEYSTORE=szept.keystore
SZEPT_STORE_PASS=
SZEPT_KEY_ALIAS=szept
SZEPT_KEY_PASS=

# Zaszyfrowany (hasłem administratora) klucz konta „Szept” — bez niego panel administratora jest wyłączony
SZEPT_ADMIN_ENC=

# Opcjonalnie: klucz wyszukiwarki GIF-ów KLIPY (klipy.com)
KLIPY_KEY=

# Opcjonalnie: wbudowane serwery TURN (rozmowy przez sieć komórkową) — szyfrowane przy budowaniu
TURN1_URLS=
TURN1_USER=
TURN1_PASS=
TURN2_URLS=
TURN2_USER=
TURN2_PASS=
# Opcjonalnie: Metered — świeże dane logowania przez API
METERED_API_URL=
METERED_API_KEY=
